---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/footer.astro";
import { Image } from "astro:assets";

import ContactImg from "../assets/Contact.png";
---

<Layout>
  <Header />

  <main class="contact-page">
    <!-- HERO: Contact + illustration + grøn knap -->
    <section class="contact-hero reveal">
      <div class="contact-hero-text">
        <h1>Contact</h1>
        <p>We’d love to hear from you – whether you’re curious, collaborating, or ready to rethink packaging.</p>
        <button class="primary-btn" onclick="document.getElementById('contact-form').scrollIntoView({ behavior: 'smooth', block: 'start' });"> Send a message </button>
      </div>

      <div class="contact-hero-image reveal">
        <Image src={ContactImg} alt="Contact illustration" />
      </div>
    </section>

    <!-- SEKTION 2: Let's build something together + form -->
    <section class="contact-build reveal">
      <div class="build-text">
        <h2>Let’s build something<br />together</h2>

        <p>We work with brands, creators, and visionaries to design packaging that truly matters.</p>
        <p>From concept to creation, we craft thoughtful, sustainable solutions that tell your story and respect the planet.</p>
        <p>Reach out — and let’s start your TÓKI flow.</p>

        <div class="contact-info reveal">
          <div class="info-row">
            <span class="info-icon">📍</span>
            <span class="info-text">Copenhagen, Denmark</span>
          </div>
          <div class="info-row">
            <span class="info-icon">✉️</span>
            <span class="info-text">hello@toki.dk</span>
          </div>
          <div class="info-row">
            <span class="info-icon">🌍</span>
            <span class="info-text">www.toki.dk</span>
          </div>
        </div>
      </div>

      <div class="build-form-wrapper" id="contact-form">
        <div class="contact-form-card reveal">
          <div class="form-group">
            <label for="name">Name</label>
            <input id="name" type="text" />
          </div>

          <div class="form-group">
            <label for="company">Company</label>
            <input id="company" type="text" />
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input id="email" type="email" />
          </div>

          <div class="form-group form-message">
            <label for="message">Message</label>
            <textarea id="message" rows="4"></textarea>
          </div>
        </div>

        <button class="primary-btn submit-btn reveal">Submit</button>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contact-page {
    display: flex;
    flex-direction: column;
    gap: 120px;
  }

  /* HERO */
  .contact-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 60px;
    margin-top: 50px;
  }

  .contact-hero-text h1 {
    font-size: 3rem;
    color: #f9fcf9;
    margin-bottom: 10px;
  }

  .contact-hero-text p {
    color: #f9fcf9;
    max-width: 420px;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .contact-hero-image img {
    width: 320px;
    height: auto;
  }

  .primary-btn {
    font-family: "Baloo 2";
    padding: 12px 50px;
    font-size: 1.2rem;
    background-color: #4db652;
    color: #f9fcf9;
    cursor: pointer;
    border-radius: 20px;
    border: none;
    transition:
      transform 0.25s ease,
      background-color 0.25s ease;
  }

  .primary-btn:hover {
    background-color: #b2f432;
    transform: scale(1.05);
  }

  #contact-form {
    scroll-margin-top: 80px;
  }

  /* BUILD SOMETHING + FORM */
  .contact-build {
    display: grid;
    grid-template-columns: 1.4fr 1.2fr;
    gap: 80px;
    align-items: flex-start;
    margin-bottom: 80px;
  }

  .build-text h2 {
    font-size: 2.5rem;
    color: #f9fcf9;
    margin-bottom: 20px;
  }

  .build-text p {
    color: #f9fcf9;
    max-width: 460px;
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .contact-info {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .info-icon {
    font-size: 1.4rem;
  }

  .info-text {
    color: #f9fcf9;
    font-size: 1rem;
  }

  .build-form-wrapper {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-end;
  }

  .contact-form-card {
    background-color: #f9fcf9;
    border-radius: 16px;
    padding: 24px 26px 26px;
    width: 100%;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-group {
    background-color: #143943;
    border-radius: 10px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    color: #f9fcf9;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .form-group input,
  .form-group textarea {
    border-radius: 6px;
    border: none;
    padding: 8px 10px;
    font-size: 0.95rem;
    outline: none;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 90px;
  }

  .submit-btn {
    align-self: center;
  }

  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }

  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsiv */
  @media (max-width: 900px) {
    .contact-hero {
      flex-direction: column;
      align-items: flex-start;
    }

    .contact-hero-image img {
      width: 260px;
    }

    .contact-build {
      grid-template-columns: 1fr;
    }

    .build-form-wrapper {
      align-items: stretch;
    }

    .submit-btn {
      align-self: center;
    }
  }
</style>

<script>
  if (typeof window !== "undefined") {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    });
  }
</script>
