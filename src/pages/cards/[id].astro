---
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/footer.astro";
export async function getStaticPaths() {
  const endpoint = "https://zkmujamnmqaduorxifhm.supabase.co/rest/v1/toki?select=*";

  const key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InprbXVqYW1ubXFhZHVvcnhpZmhtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjMxNDA0MDQsImV4cCI6MjA3ODcxNjQwNH0.j_JD3IhIE1NNbCVCpxnJ1jJ_0IoNr9iT-9LKskbRP7E";
  const options = {
    method: "GET",
    headers: {
      apikey: key,
    },
  };

  const response = await fetch(endpoint, options);
  const data = await response.json();

  return data.map((post) => {
    return {
      params: { id: post.id },
      props: { post },
    };
  });
}

const { id } = Astro.params;
const { post } = Astro.props;

const fullDescription = post.description || "";
const firstDotIndex = fullDescription.indexOf(".");

let intro = fullDescription;
let body = "";

if (firstDotIndex !== -1) {
  intro = fullDescription.slice(0, firstDotIndex + 1).trim();
  body = fullDescription.slice(firstDotIndex + 1).trim();
}
---

<Layout>
  <Header />
  <div class="hero reveal">
    <h1>{post.type} packaging</h1>
    <img src="/src/assets/productcard.svg" alt="A bunch of Toki products" />
  </div>

  <div class="packaging">
    <h2>Sustainable {post.type} packaging</h2>
    <div class="grid-item reveal">
      {post.imgs && <img src={post.imgs} alt={post.title} />}
    </div>
    <h2 class="pure">Pure by design</h2>
    <div class="about-product reveal">
      <p class="about-intro">{intro}</p>
      <p class="about-body">{body}</p>
      <div class="cta">
        <a href="/about">
          <button>Learn more</button>
        </a>
      </div>
      <div class="cta">
        <a href="/contact">
          <button>Contact</button>
        </a>
      </div>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }

  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .hero {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    text-align: center;
    padding: 100px 100px;
    margin-left: 100px;
    margin-right: 100px;
  }
  .hero img {
    width: 500px;
    height: auto;
  }

  .packaging {
    margin: 0;
  }

  .packaging h2 {
    font-size: 2rem;
    color: #f9fcf9;
    background-color: #143943;
    display: inline-block;
    padding: 10px 60px 10px 185px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    text-align: left;
    margin: 0;
    box-sizing: border-box;
  }

  .packaging h2.pure {
    margin-left: auto;
    display: block;
    width: fit-content;
    padding: 10px 185px 10px 60px;
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    text-align: center;
  }

  .grid-item {
    background-color: #143943;
    border: none;
    border-radius: 20px;
    text-align: center;
    padding: 20px;
    max-width: 600px;
    margin: 40px auto;
  }
  .grid-item img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .about-product {
    background-color: #143943;
    color: #f9fcf9;
    max-width: 600px;
    margin: 40px auto;
    padding: 20px 40px;
    border-radius: 20px;
    box-sizing: border-box;
    text-align: left;
  }

  .about-intro {
    white-space: pre-line;
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .about-body {
    white-space: pre-line;
  }

  .cta {
    display: flex;
    flex-direction: row;
    justify-content: center;
    margin-bottom: 30px;
    padding-top: 50px;
  }

  .cta button {
    font-family: "Baloo 2";
    padding: 10px 50px;
    font-size: 1.2rem;
    background-color: #4db652;
    color: #f9fcf9;
    cursor: pointer;
    border-radius: 20px;
    border: none;
    transition:
      transform 0.3s ease,
      color 0.3s ease;
  }

  .cta button:hover {
    padding: 10px 50px;
    font-size: 1.2rem;
    background-color: #b2f432;
    color: #f9fcf9;
    cursor: pointer;
    border-radius: 20px;
    border: none;
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 40px 20px;
      margin-left: 0;
      margin-right: 0;
      gap: 20px;
    }

    .hero img {
      width: 100%;
      max-width: 320px;
      height: auto;
    }

    .packaging h2 {
      font-size: 1.4rem;
      padding: 10px 20px;
      border-top-right-radius: 20px;
      border-bottom-right-radius: 20px;
    }

    .packaging h2.pure {
      margin-left: 0;
      padding: 10px 20px;
      width: auto;
      border-top-left-radius: 20px;
      border-bottom-left-radius: 20px;
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
      text-align: left;
    }

    .grid-item {
      max-width: 100%;
      margin: 20px 16px;
      padding: 20px;
    }

    .about-product {
      max-width: 100%;
      margin: 20px 16px 40px 16px;
      padding: 20px;
    }

    .about-intro {
      font-size: 1.1rem;
    }

    .cta {
      margin-bottom: 10px;
      padding-top: 30px;
    }

    .cta button {
      width: 100%;
      max-width: 260px;
    }
  }
</style>

<script>
  if (typeof window !== "undefined") {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    });
  }
</script>
