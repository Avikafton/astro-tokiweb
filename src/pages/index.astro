---
import Header from "../components/Header.astro";
import Footer from "../components/footer.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import IndexImg from "../assets/index.png";
import TokiflowImg from "../assets/1tokiflow.png";
import LightImg from "../assets/light.png";

const endpoint = "https://zkmujamnmqaduorxifhm.supabase.co/rest/v1/toki?select=*";

const key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InprbXVqYW1ubXFhZHVvcnhpZmhtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjMxNDA0MDQsImV4cCI6MjA3ODcxNjQwNH0.j_JD3IhIE1NNbCVCpxnJ1jJ_0IoNr9iT-9LKskbRP7E";
const options = {
  method: "GET",
  headers: {
    apikey: key,
  },
};

const response = await fetch(endpoint, options);
const data = await response.json();
---

<Layout>
  <Header />

  <main>
    <div class="hero reveal">
      <h1>Sustainable packaging for a better future</h1>
      <Image src={IndexImg} alt="Index" class="hero-image" />
    </div>

    <div class="cta reveal">
      <a href="/about">
        <button>Learn more</button>
      </a>
    </div>

    <section class="toki-flow reveal">
      <h2>Toki Flow</h2>
    </section>
      
    <div id="pointer" style="
        position: absolute;
        top: 845px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 20px solid transparent;
        border-right: 20px solid transparent;
        border-top: 40px solid #b2f432; /* spids nedad */
        z-index: 10;
      "></div>

      <div style="position: relative; display: flex; justify-content: center; align-items: flex-start; gap: 20px;">
        <div id="tokiText" style="
            width: 250px;
            height: 350px;
            color: #f9fcf9;
            background-color: #143943;
            padding: 20px;
            border-radius: 10px;
            position: absolute;
            top: 20px;
            left: 0;
            overflow-y: auto;
            box-sizing: border-box;
            cursor: pointer;
            visibility: visible;
            opacity: 1;
            transition: opacity 0.3s ease;
        ">
          <strong>Click the wheel to learn about Toki Flow!</strong>
        </div>
      
        <div class="toki-flow-image" id="tokiWheel" style="width: 400px; cursor: pointer; transition: transform 0.5s ease-out;">
          <Image src={TokiflowImg} alt="Toki Flow Image" style="width: 100%; height: auto; display: block;" />
        </div>
      </div>

    <section class="left-title reveal">
      <div class="title-wrapper">
        <h2>Our solutions <Image src={LightImg} alt="Left Title Image" /></h2>
      </div>
    </section>

    <div class="grid">
      {
        data.map((item) => (
          <a href={`/cards/${item.id}`} class="grid-item reveal">
            <h3>{item.Title}</h3>
            {item.imgs && <img src={item.imgs} alt={item.title} />}
          </a>
        ))
      }
    </div>
  </main>



  <Footer />
  <style>
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition:
        opacity 0.6s ease-out,
        transform 0.6s ease-out;
    }

    .reveal.in-view {
      opacity: 1;
      transform: translateY(0);
    }
    :global(html, body) {
      margin: 0;
      padding: 0;
      max-width: 100%;
      overflow-x: hidden;
    }
    .hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 10px;
    }

    .hero h1 {
      text-align: left;
      font-size: 60px;
      color: #f9fcf9;
    }

    .hero-image {
      width: 350px;
      height: auto;
    }

    .cta {
      display: flex;
      justify-content: center;
      margin-bottom: 100px;
    }

    .cta button {
      font-family: "Baloo 2";
      padding: 10px 50px;
      font-size: 1.2rem;
      background-color: #4db652;
      color: #f9fcf9;
      cursor: pointer;
      border-radius: 20px;
      border: none;
      transition:
        transform 0.3s ease,
        color 0.3s ease;
    }

    .cta button:hover {
      padding: 10px 50px;
      font-size: 1.2rem;
      background-color: #b2f432;
      color: #f9fcf9;
      cursor: pointer;
      border-radius: 20px;
      border: none;
      transform: scale(1.05);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 20px;
    }

    .grid-item {
      background-color: #143943;
      border: none;
      border-radius: 20px;
      text-align: center;
      padding: 20px;
    }

    .grid-item h3 {
      color: #f9fcf9;
    }

    .grid-item img {
      max-width: 150px;
      width: 100%;
      height: 150px;
    }

    .grid-item.slim img {
      width: 40%;
    }

    .grid-item.plastic img {
      width: 25%;
    }

    .grid-item:hover {
      background-color: #1a4b56;
      transform: scale(1.03);
      transition:
        transform 0.3s ease,
        background-color 0.3s ease;
    }
    .toki-flow {
      width: 85vw;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      margin: 100px 0;
    }

    .toki-flow h2 {
      font-size: 2rem;
      color: #f9fcf9;
      background-color: #143943;
      display: inline-block;
      padding: 10px 500px 10px 20px;
      border-top-left-radius: 20px;
      border-bottom-left-radius: 20px;
      text-align: left;
      margin: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

  

    .left-title {
      width: 100vw;
      margin: 100px 0;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);

      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: flex-start;

      color: #f9fcf9;
    }

    .title-wrapper {
      width: 100%;
      display: flex;
      justify-content: flex-start;
    }

    .left-title h2 {
      font-size: 2rem;
      margin: 0;
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      color: #f9fcf9;
      background-color: #143943;
      text-align: right;
      padding: 10px 20px 10px 280px;
      border-top-right-radius: 20px;
      border-bottom-right-radius: 20px;
    }

    .title-wrapper img {
      max-width: 80px;
      width: auto;
      height: auto;
      object-fit: cover;
    }



    
    @media (max-width: 768px) {
      :global(body) {
        overflow-x: hidden;
      }
      main {
        padding: 16px;
        margin: 0;
      }

      .hero {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 32px;
      }

      .hero h1 {
        font-size: 2.2rem;
        text-align: left;
      }

      .hero-image {
        width: 100%;
        max-width: 280px;
        margin: 0 auto;
        display: block;
      }

      .cta {
        margin-bottom: 40px;
      }

      .cta button {
        width: 100%;
        max-width: 260px;
      }

      .toki-flow {
        width: calc(100% + 32px);
        margin: 40px -16px 24px -16px;
        align-items: flex-end;
      }

      .toki-flow h2 {
        font-size: 1.4rem;
        padding: 10px 16px;
        text-align: right;
      }

      .toki-flow-image {
        margin-top: 16px;
        padding: 0 8px;
      }

      .toki-flow-image img {
        max-width: 100%;
      }

      .left-title {
        width: 100vw;
        margin: 40px 0 24px 0;
        margin-left: calc(50% - 50vw);
      }

      .title-wrapper {
        flex-direction: column;
        align-items: flex-start;
        padding: 16px;
        gap: 12px;
      }

      .left-title h2 {
        padding: 0;
        font-size: 1.4rem;
        text-align: left;
      }

      .title-wrapper img {
        max-width: 100px;
      }

      .grid {
        grid-template-columns: 1fr;
        gap: 16px;
        margin: 0 0 32px 0;
        width: 100%;
      }

      .grid-item {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        margin: 0;
      }

      .grid-item img {
        max-width: 100px;
        width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
      }
    }
  </style>

  <script>
    if (typeof window !== "undefined") {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );

      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
  let currentRotation = 0;
  const wheel = document.getElementById("tokiWheel");
  const textBox = document.getElementById("tokiText");

  const messages = [
  "<strong>INSIGHT:</strong> We conduct extensive research to identify opportunities for sustainable packaging solutions. This involves analyzing raw materials, assessing environmental impact, understanding consumer behavior, and evaluating market trends. Our goal is to uncover actionable insights that help businesses reduce their ecological footprint while staying innovative and competitive in the market.",

  "<strong>DESIGN DNA:</strong> We develop packaging concepts that combine aesthetics, functionality, and sustainability. Every design decision—from material selection to shape and branding—is carefully considered to minimize waste, energy consumption, and carbon emissions. Our designs aim to create a memorable user experience while adhering to eco-friendly principles.",

  "<strong>SOLUTION:</strong> Based on our research and design DNA, we create concrete solutions that include prototypes, testing methods, and optimized production techniques. We focus on innovative approaches such as biodegradable materials, reusable packaging, and modular designs that can be scaled efficiently while maintaining high-quality standards.",

  "<strong>IDEAS:</strong> We continuously generate new ideas for products and services that contribute to a circular economy. Our brainstorming sessions and collaborative workshops emphasize creativity, sustainability, and practicality, encouraging novel solutions that are both environmentally responsible and commercially viable.",

  "<strong>SCALING:</strong> We strategize how to implement our solutions on a larger scale. This includes planning manufacturing processes, logistics, distribution, and marketing strategies that enable widespread adoption. Our focus is on empowering businesses to transition to sustainable packaging practices without compromising efficiency or profitability."
];

  wheel.addEventListener("click", () => {
    currentRotation -= 72;
    wheel.style.transform = `rotate(${currentRotation}deg)`;

    const index = ((-currentRotation / 72) % messages.length + messages.length) % messages.length;
    textBox.innerHTML = messages[index];

    // vis boksen hvis den var skjult
    textBox.style.visibility = "visible";
    textBox.style.opacity = "1";
  });

  textBox.addEventListener("click", () => {
    if (textBox.style.visibility === "hidden") {
      textBox.style.visibility = "visible";
      textBox.style.opacity = "1";
    } else {
      textBox.style.visibility = "hidden";
      textBox.style.opacity = "0";
    }
  });
});
  </script>
</Layout>
