---
import { Image } from "astro:assets";
import Logo from "../assets/logo.png";
---

<footer class="footer">
  <!-- Venstre: logo + tagline + links -->
  <div class="footer-left">
    <div class="footer-brand">
      <div class="footer-logo">
        <Image src={Logo} alt="TÓKI Logo" />
      </div>
      <div class="footer-tagline">
        <p>Smarter packaging</p>
        <p>for a better world</p>
      </div>
    </div>

    <nav class="footer-nav">
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>

  <!-- Midten: sociale medier -->
  <div class="footer-socials">
    <a href="#" aria-label="Facebook" class="social-circle">
      <!-- Facebook inline SVG (hvid) -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="social-icon">
        <path
          d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"
        ></path>
      </svg>
    </a>

    <a href="#" aria-label="Instagram" class="social-circle">
      <!-- Instagram inline SVG (hvid) -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="social-icon">
        <path
          d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"
        ></path>
      </svg>
    </a>
  </div>

  <!-- Højre: Newsletter -->
  <div class="footer-newsletter">
    <h3>Newsletter</h3>

    <form class="newsletter-box">
      <input type="email" placeholder="Enter your email" class="newsletter-input" />
      <button type="submit" class="newsletter-button"> Subscribe </button>
    </form>
  </div>

  <!-- Bundlinje -->
  <div class="footer-bottom">© 2025 TÓKI. All rights reserved</div>
</footer>

<style>
  .footer {
    background-color: #143943;
    padding: 60px 80px 90px;
    display: grid;
    grid-template-columns: 1.7fr 1fr 1.7fr;
    align-items: center;
    gap: 40px;
    position: relative;
    margin-top: 10rem;
  }

  /* VENSTRE SIDE */
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .footer-logo img {
    width: 120px;
    height: auto;
    display: block;
  }

  .footer-tagline {
    color: #f9fcf9;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .footer-tagline p {
    margin: 0;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 10px;
  }

  .footer-nav a {
    color: #f9fcf9;
    font-size: 1.4rem;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: #b2f432;
    text-decoration: none;
  }

  /* SOCIALE MEDIER */
  .footer-socials {
    display: flex;
    justify-content: center;
    gap: 40px;
  }

  .social-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: #b2f432;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .social-circle:hover {
    background-color: #b2f432;
    filter: brightness(1.1);
  }

  .social-icon {
    width: 34px;
    height: 34px;
    color: #ffffff; /* gør SVG hvid via currentColor */
    fill: currentColor;
  }

  /* NEWSLETTER */
  .footer-newsletter {
    text-align: center;
  }

  .footer-newsletter h3 {
    color: #f9fcf9;
    font-size: 2rem;
    margin-bottom: 20px;
  }

  .newsletter-box {
    display: flex;
    border: 3px solid #b2f432;
    border-radius: 14px;
    overflow: hidden;
    max-width: 520px;
    margin: 0 auto;
  }

  .newsletter-input {
    flex: 1;
    padding: 16px 22px;
    font-size: 1.1rem;
    border: none;
    outline: none;
    background-color: #143943; /* samme som footer-baggrund */
    color: #f9fcf9;
  }

  .newsletter-input::placeholder {
    color: #f9fcf9;
  }

  .newsletter-button {
    background-color: #b2f432;
    color: #143943;
    font-weight: 700;
    padding: 16px 32px;
    font-size: 1.1rem;
    border: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .newsletter-button:hover {
    filter: brightness(1.05);
  }

  /* COPYRIGHT */
  .footer-bottom {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    color: #f9fcf9;
    font-size: 1rem;
    font-weight: 600;
  }

  /* RESPONSIV */
  @media (max-width: 1000px) {
    .footer {
      grid-template-columns: 1fr;
      gap: 50px;
      text-align: center;
    }

    .footer-brand {
      justify-content: center;
    }

    .footer-left,
    .footer-newsletter {
      align-items: center;
    }

    .footer-nav {
      align-items: center;
    }

    .footer-bottom {
      position: static;
      margin-top: 20px;
      transform: none;
    }
  }

  @media (max-width: 600px) {
    .footer {
      padding: 40px 24px 60px;
      gap: 32px;
    }

    .footer-logo img {
      width: 90px;
      height: auto;
    }

    .footer-tagline {
      font-size: 1.2rem;
    }

    .footer-nav a {
      font-size: 1.1rem;
    }

    .footer-socials {
      gap: 24px;
    }

    .social-circle {
      width: 56px;
      height: 56px;
    }

    .social-icon {
      width: 26px;
      height: 26px;
    }

    .footer-newsletter h3 {
      font-size: 1.6rem;
    }

    .newsletter-box {
      flex-direction: column;
      max-width: 100%;
    }

    .newsletter-input {
      width: 100%;
      text-align: center;
    }

    .newsletter-button {
      width: 100%;
      text-align: center;
    }
  }
</style>
